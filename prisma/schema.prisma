generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Usuário que operará o sistema, gerenciando usuários (caso seja administrador), clientes e tarefas
model Usuario {
  id            String   @id @default(cuid())
  nome          String
  sobrenome     String
  nivel_acesso  String
  setor         String
  cargo         String
  email         String   @unique
  senha         String
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  tarefas Tarefa[]
  logs    UsuarioLog[]
}

// Registro de alterações de usuários
model UsuarioLog {
  id        String   @id @default(cuid())
  usuarioId String?
  acao      String // Criado, Editado ou Apagado
  detalhes  String?
  criado_em DateTime @default(now())
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
}

// Serviços oferecidos pela empresa, que podem ser contratados por seus clientes
model Servico {
  id             String   @id @default(cuid())
  clienteId      String?
  titulo         String
  descricao      String?
  preco          Float // Preço do serviço
  contratado_por Cliente? @relation(fields: [clienteId], references: [id]) // Cliente que contratou o serviço
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt
}

// Cliente que contratou a empresa
model Cliente {
  id            String   @id @default(cuid())
  nome          String // Nome ou razão social
  documento     String // CPF ou CNPJ
  valor         Float? // Valor total dos serviços contratados pelo cliente
  descricao     String?
  tarefaId      String?
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  tarefas  Tarefa[]
  servicos Servico[] // Serviços contratados pelo cliente
}

// Tarefa que um cliente da empresa solicitou e que deve ser gerenciada ou feita pelos administradores e feita pelos usuários
model Tarefa {
  id            String   @id @default(cuid())
  clienteId     String?
  titulo        String
  descricao     String?
  demandado_por Cliente? @relation(fields: [clienteId], references: [id])
  prazo         String?
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  responsaveis Usuario[]
}
