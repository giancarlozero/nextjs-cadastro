generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String   @id @default(cuid())
  nome          String
  setor         String
  cargo         String
  usuario       String
  senha         String
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt
}
