generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String   @id @default(cuid())
  nome          String
  sobrenome     String
  nivel_acesso  String
  setor         String
  cargo         String
  email         String   @unique
  senha         String
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  logs UsuarioLog[]
}

model UsuarioLog {
  id        String   @id @default(cuid())
  usuarioId String?
  acao      String // Criado, Editado ou Apagado
  detalhes  String?
  criado_em DateTime @default(now())
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
}
